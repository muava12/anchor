<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen reminder sheet. Translucent activity, bottom-anchored solid
     surface card. Content-first / flat, per the Doop "Reminder — Sheet flat"
     frame: header (accent bell + app meta), bold title, muted body, then four
     full-width icon+label actions with generous spacing. No dim overlay. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/fsi_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_fsi_sheet"
        android:fontFamily="@font/dm_sans"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:textColor="@color/fsi_text"
        tools:ignore="UnusedAttribute">

        <!-- Header: accent bell + meta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_fsi_header_bell" />

            <TextView
                android:id="@+id/fsi_header_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/dm_sans"
                android:fontVariationSettings="'wght' 600"
                android:singleLine="true"
                android:textColor="@color/fsi_muted"
                android:textSize="13sp"
                tools:ignore="NewApi" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/fsi_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans"
            android:fontVariationSettings="'wght' 700"
            android:letterSpacing="-0.015"
            android:lineSpacingMultiplier="0.25"
            android:textColor="@color/fsi_text"
            android:textSize="20sp"
            tools:ignore="NewApi" />

        <!-- Body -->
        <TextView
            android:id="@+id/fsi_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/dm_sans"
            android:lineSpacingMultiplier="0.5"
            android:textColor="@color/fsi_muted"
            android:textSize="13.5sp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btn_mark_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fsi_check" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/dm_sans"
                    android:fontVariationSettings="'wght' 500"
                    android:text="@string/fsi_action_done"
                    android:textColor="@color/fsi_text"
                    android:textSize="13.5sp"
                    tools:ignore="NewApi" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_dismiss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fsi_bell_off" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/dm_sans"
                    android:fontVariationSettings="'wght' 500"
                    android:text="@string/fsi_action_dismiss"
                    android:textColor="@color/fsi_text"
                    android:textSize="13.5sp"
                    tools:ignore="NewApi" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_snooze"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fsi_bell" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/dm_sans"
                    android:fontVariationSettings="'wght' 500"
                    android:text="@string/fsi_action_snooze"
                    android:textColor="@color/fsi_text"
                    android:textSize="13.5sp"
                    tools:ignore="NewApi" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_close"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_fsi_arrow_down" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/dm_sans"
                    android:fontVariationSettings="'wght' 500"
                    android:text="@string/fsi_action_close"
                    android:textColor="@color/fsi_text"
                    android:textSize="13.5sp"
                    tools:ignore="NewApi" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
