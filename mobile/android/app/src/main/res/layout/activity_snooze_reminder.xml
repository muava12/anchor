<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone snooze sheet (Doop "Reminder — Snooze picker (sheet flat)",
     frame Wn02ojCMhA). Translucent activity: dim scrim + bottom-anchored
     surface card with 28dp rounded top. The scrim, handle, chip and preset
     paints are set in code from the @color/fsi_* tokens so one set of
     shapes serves light + dark. Every option is wired to the native
     re-schedule logic (SnoozeScheduleHelper + PendingSnoozeStore). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Dim scrim behind the sheet; paint (day/night alpha) set in code. -->
    <View
        android:id="@+id/snooze_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/snooze_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_snooze_sheet"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:textColor="@color/fsi_text">

        <!-- 32×4dp grab handle, rounded, fsi_muted @ ~38% (paint in code) -->
        <View
            android:id="@+id/snooze_handle"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal" />

        <!-- Header: centered title + centered subtitle -->
        <TextView
            android:id="@+id/snooze_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/dm_sans"
            android:fontVariationSettings="'wght' 700"
            android:gravity="center_horizontal"
            android:letterSpacing="-0.015"
            android:text="@string/snooze_sheet_title"
            android:textColor="@color/fsi_text"
            android:textSize="20sp"
            tools:ignore="NewApi" />

        <TextView
            android:id="@+id/snooze_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/dm_sans"
            android:fontVariationSettings="'wght' 400"
            android:gravity="center_horizontal"
            android:singleLine="true"
            android:textColor="@color/fsi_muted"
            android:textSize="14sp"
            tools:ignore="NewApi"
            tools:text="Stand up · repeats daily" />

        <!-- "Snooze for" section: label + wrapping chip row -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/dm_sans"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="0.05"
            android:text="@string/snooze_label_snooze_for"
            android:textAllCaps="true"
            android:textColor="@color/fsi_muted"
            android:textSize="12sp"
            tools:ignore="NewApi" />

        <!-- The five chips (pill backgrounds + default selection in code).
             The "1 day" chip is hidden for one-shot reminders. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_10min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/dm_sans"
                    android:fontVariationSettings="'wght' 500"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/snooze_chip_10min"
                    android:textColor="@color/fsi_text"
                    android:textSize="12.5sp"
                    tools:ignore="NewApi" />

                <TextView
                    android:id="@+id/chip_30min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/dm_sans"
                    android:fontVariationSettings="'wght' 500"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/snooze_chip_30min"
                    android:textColor="@color/fsi_text"
                    android:textSize="12.5sp"
                    tools:ignore="NewApi" />

                <TextView
                    android:id="@+id/chip_1hour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/dm_sans"
                    android:fontVariationSettings="'wght' 500"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/snooze_chip_1hour"
                    android:textColor="@color/fsi_text"
                    android:textSize="12.5sp"
                    tools:ignore="NewApi" />

                <TextView
                    android:id="@+id/chip_4hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/dm_sans"
                    android:fontVariationSettings="'wght' 500"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/snooze_chip_4hours"
                    android:textColor="@color/fsi_text"
                    android:textSize="12.5sp"
                    tools:ignore="NewApi" />

                <TextView
                    android:id="@+id/chip_1day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/dm_sans"
                    android:fontVariationSettings="'wght' 500"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/snooze_chip_1day"
                    android:textColor="@color/fsi_text"
                    android:textSize="12.5sp"
                    tools:ignore="NewApi" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- "Today" section: label + three full-width preset buttons -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/dm_sans"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="0.05"
            android:text="@string/snooze_label_today"
            android:textAllCaps="true"
            android:textColor="@color/fsi_muted"
            android:textSize="12sp"
            tools:ignore="NewApi" />

        <LinearLayout
            android:id="@+id/preset_later_today"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_snooze_clock" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/dm_sans"
                android:fontVariationSettings="'wght' 500"
                android:text="@string/snooze_preset_later_today"
                android:textColor="@color/fsi_text"
                android:textSize="13.5sp"
                tools:ignore="NewApi" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/preset_tomorrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_snooze_calendar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/dm_sans"
                android:fontVariationSettings="'wght' 500"
                android:text="@string/snooze_preset_tomorrow"
                android:textColor="@color/fsi_text"
                android:textSize="13.5sp"
                tools:ignore="NewApi" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/preset_pick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_snooze_calendar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/dm_sans"
                android:fontVariationSettings="'wght' 500"
                android:text="@string/snooze_preset_pick"
                android:textColor="@color/fsi_text"
                android:textSize="13.5sp"
                tools:ignore="NewApi" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
